{
  "buildCommand": "CI=false yarn build",
  "outputDirectory": "build",
  "functions": {
    "api/render.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tdl-image/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/kami-street",
      "destination": "https://kamistreet.fr/",
      "permanent": true
    },
    {
      "source": "/caces-debouches-metiers-cariste/",
      "destination": "/blog/debouches-caces-metiers-salaires-et-secteurs-qui-recrutent",
      "permanent": true
    },
    {
      "source": "/caces-debouches-metiers-cariste",
      "destination": "/blog/debouches-caces-metiers-salaires-et-secteurs-qui-recrutent",
      "permanent": true
    },
    {
      "source": "/passerelle-vtc-taxi/",
      "destination": "/formations/formation-passerelle-vtc-vers-taxi",
      "permanent": true
    },
    {
      "source": "/passerelle-vtc-taxi",
      "destination": "/formations/formation-passerelle-vtc-vers-taxi",
      "permanent": true
    },
    {
      "source": "/formation-caces-r489-chariots/",
      "destination": "/formations/caces-r489-cat-3-chariot-elevateur",
      "permanent": true
    },
    {
      "source": "/formation-caces-r489-chariots",
